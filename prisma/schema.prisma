
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String?
  googleId       String?   @unique
  role           UserRole  @default(CUSTOMER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tickets        Ticket[]  @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")
  comments       Comment[]
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  aiPriority  TicketPriority?
  category    String?
  aiSummary   String?
  aiReply     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creatorId   String
  creator     User           @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  assigneeId  String?
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    Comment[]

  @@index([status, createdAt])
  @@index([priority])
  @@index([creatorId, createdAt])
  @@index([assigneeId, status])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}
